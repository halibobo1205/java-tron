
net { type = mainnet }

storage {
  db.engine = "ROCKSDB"
  db.sync = false
  db.directory = "database"
  index.directory = "index"
  transHistory.switch = "on"
  snapshot.maxFlushCount = 1

  archive {
    enable = true
    db {
      directory = "archive"
      fullScrubOnStartup = false
    }
    identity.initialize = true
    txnum.enable = true
    temporal.enable = true
    publisher {
      async = true
      backpressure = true
    }
    commitment.enable = false
    debug.enable = false
    coverage = "TVM_STATE_ONLY"
    warnUnclassifiedStoreWrites = true
  }
}

node.discovery = {
  enable = false
  persist = false
}

node {
  trustNode = "127.0.0.1:50051"
  walletExtensionApi = true
  listen.port = 18888
  connectFactor = 0.3
  activeConnectFactor = 0.1
  maxHttpConnectNumber = 50

  p2p {
    version = 20260719
  }

  active = []
  passive = []
  fastForward = []

  http {
    fullNodeEnable = true
    fullNodePort = 8090
    solidityEnable = false
    PBFTEnable = false
  }

  rpc {
    enable = true
    port = 50051
    solidityEnable = false
    PBFTEnable = false
    minEffectiveConnection = 0
  }

  jsonrpc {
    httpFullNodeEnable = true
    httpFullNodePort = 8545
  }
}

seed.node = {
  ip.list = []
}

